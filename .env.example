# Google Gemini Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3-pro
GEMINI_CONTEXT_SIZE=1000000
GEMINI_THINKING_MODE=true

# Google Antigravity Configuration
ANTIGRAVITY_WORKSPACE_ID=your_workspace_id_here
ANTIGRAVITY_API_KEY=your_antigravity_api_key_here
ANTIGRAVITY_ENDPOINT=https://antigravity.google.com/api/v1

# Firebase Configuration
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_DATABASE_URL=https://your_project.firebaseio.com
FIREBASE_STORAGE_BUCKET=your_project.appspot.com

# Google Maps API
GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Bhashini API (Indian Languages)
BHASHINI_API_KEY=your_bhashini_api_key
BHASHINI_USER_ID=your_bhashini_user_id
BHASHINI_ENDPOINT=https://bhashini.gov.in/api/v1

# Agent Configuration
AGENT_MAX_PARALLEL=3
AGENT_TIMEOUT_MS=30000
AGENT_RETRY_ATTEMPTS=3

# Logging
LOG_LEVEL=info
LOG_TO_FILE=true

# Development
NODE_ENV=development
PORT=3000
