# Google Cloud Platform
GCP_PROJECT_ID=your-project-id
GCP_REGION=asia-south1

# Firebase
FIREBASE_CREDS_PATH=config/firebase-creds.json

# WhatsApp Business API (Twilio)
WHATSAPP_API_URL=https://api.twilio.com/2010-04-01
WHATSAPP_ACCOUNT_SID=your_account_sid
WHATSAPP_AUTH_TOKEN=your_auth_token
WHATSAPP_FROM_NUMBER=whatsapp:+14155238886

# Google Maps API
GOOGLE_MAPS_API_KEY=your_maps_api_key

# ONDC/Beckn Protocol
ONDC_GATEWAY_URL=https://pilot-gateway-1.beckn.nsdl.co.in
BECKN_NETWORK_ID=your_network_id

# Demo mode
DEMO_MODE=true
